{
  "name": "the-dump-mcp",
  "version": "2.0.0",
  "description": "MCP server for The Dump \u2014 save LLM conversations and notes, and read them back as context. Runs locally over stdio (npx) or hosted at mcp.thedump.ai over Streamable HTTP with OAuth.",
  "license": "MIT",
  "homepage": "https://thedump.ai/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/George-Labs-AI/The_Dump_MCP.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "the-dump",
    "notes",
    "oauth",
    "streamable-http"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "the-dump-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
